<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>James Pfaff</Authors>
    <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>
    <PackageTags>pioneer;prodjlink;dj;cdj;rekordbox;beat-link</PackageTags>
    <Description>A .NET library for synchronizing with beats from Pioneer DJ Link equipment, and finding out details about the tracks that are playing. A port of Deep Symmetry's beat-link Java library.</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
